# Bench test C8 (H4-C): DATA IN hand-over on the FujiNet alone, USB only, the Atari disconnected.
# The CI job firmware-package-bench-c8a builds it and verifies it as variant bench-c8a; not distributed
# (C8a F3, docs/hardware/banco-c8a-aislado.md).
# Applied after the board fragment, only for a bench package:
#   idf.py -B build-bench -D SDKCONFIG=build-bench/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.board.fujinet-atari-v1x;sdkconfig.bench-c8" build
# The bench grant ignores the gates: it covers GPIO21 only, at boot, then releases it.
CONFIG_RB_BENCH_C8=y
