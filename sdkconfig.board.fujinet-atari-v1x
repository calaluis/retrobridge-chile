# Board configuration fragment: FujiNet Atari ESP32 FN32ROV-1.3/1.5 (H3c).
# Applied on top of sdkconfig.defaults only on purpose:
#   idf.py -B build-fujinet -D SDKCONFIG=build-fujinet/sdkconfig \
#          -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.board.fujinet-atari-v1x" build
# Without it the build keeps RB_BOARD_UNCONFIRMED (the default).

CONFIG_RB_BOARD_FUJINET_ATARI_V1X=y

# Flash: GigaDevice 16 MB (esptool flash_id c8/4018), DIO at 40 MHz as in the
# images that ran on this board (docs/hardware/fujinet-atari-v1x.md).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# RetroBridge's own partition table (not FujiNet's).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/retrobridge-16mb.csv"

# PSRAM stays disabled in H3c: the diagnostics do not need it. GPIO16/17 remain
# reserved by the board profile regardless.
